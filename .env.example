# Valores públicos para desarrollo local. `supabase status` muestra los valores
# reales de la pila local después de ejecutar `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# No añadas aquí SUPABASE_SERVICE_ROLE_KEY, claves secretas ni credenciales de
# producción. Las variables NEXT_PUBLIC_* forman parte del bundle del navegador.
