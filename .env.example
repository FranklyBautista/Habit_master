# Valores públicos para desarrollo local. `supabase status` muestra los valores
# reales de la pila local después de ejecutar `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# No añadas aquí SUPABASE_SERVICE_ROLE_KEY, claves secretas ni credenciales de
# producción. Las variables NEXT_PUBLIC_* forman parte del bundle del navegador.

# SMTP real para que Supabase local (Auth) envíe correo de verdad en vez de
# capturarlo en Mailpit (http://127.0.0.1:54324). Solo para desarrollo local;
# van en tu propio `.env` en la raíz (nunca en este archivo ni en git).
# Genera una "contraseña de aplicación" en tu cuenta de Google (requiere
# verificación en 2 pasos activada): myaccount.google.com/apppasswords
GMAIL_SMTP_USER=tu-correo@gmail.com
GMAIL_SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Login con Google en Supabase local (cliente OAuth "Aplicación web" de Google
# Cloud). Solo se usan con `[auth.external.google] enabled = true` en tu copia
# local de supabase/config.toml; ver docs/setup/SUPABASE.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
