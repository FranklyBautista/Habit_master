{
  "name": "habit-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @habit-tracker/web dev",
    "build": "pnpm --filter @habit-tracker/web build",
    "lint": "pnpm --filter @habit-tracker/web lint",
    "lint:fix": "pnpm --filter @habit-tracker/web lint:fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && pnpm --filter @habit-tracker/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "vitest": "4.1.11"
  }
}
